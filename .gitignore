# personal config / secrets (the *.example files are tracked)
.env
lmu-coach.config.json

# recordings: large and personal (read-only data, never committed)
data/sessions/
data/reference_laps/

# generated by the tools; profile backups can be regenerated or restored by hand
data/grip_profiles/backups/
# ideal lap: fitted profiles (refit from the recordings) and per-recording npz caches (~8 MB each)
data/grip_profiles/ideal_lap/

# agent / editor state
.claude/
.openchamber/

# python
__pycache__/
*.pyc
.venv/
.pytest_cache/

# recorder safety copies and temp files
*.tmp
*.spool
*.spool.part
*.spool_hf
.stop_requested
